# Supabase — create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — Project Settings > API > service_role (KEEP SECRET, server-only)
# Required only for the "Delete account" feature in Settings > Privacy & Data
SUPABASE_SERVICE_ROLE_KEY=

# AI Providers — free tiers
# Groq: https://console.groq.com (free tier, fast inference)
GROQ_API_KEY=

# Gemini: https://aistudio.google.com/app/apikey (free tier)
GEMINI_API_KEY=

# Resend — free tier (3,000 emails/month), no credit card required
# Sign up at https://resend.com → API Keys → create one
# Used for the Contact page form (sends submissions to your inbox)
RESEND_API_KEY=

# OAuth — configure both inside Supabase Dashboard > Authentication > Providers
# Google: https://console.cloud.google.com/apis/credentials
# GitHub: https://github.com/settings/developers
# (Client ID/Secret are entered in Supabase, not here)
